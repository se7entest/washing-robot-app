<!--company.wxml-->
<view class="container">
  <!-- 公司介绍 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-title">关于我们</view>
      <view class="section-line"></view>
    </view>
    <text class="section-content">{{company.content}}</text>
  </view>

  <!-- 企业文化 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-title">{{company.culture_title || '企业文化'}}</view>
      <view class="section-line"></view>
    </view>
    <view class="culture-content">
      <text class="culture-text">{{company.culture_content}}</text>
    </view>
  </view>

  <!-- 资质证书 -->
  <view class="section-card" wx:if="{{company.certificates && company.certificates.length > 0}}">
    <view class="section-header">
      <view class="section-title">资质认证</view>
      <view class="section-line"></view>
    </view>
    <swiper class="cert-swiper" indicator-dots autoplay circular interval="3000">
      <swiper-item wx:for="{{company.certificates}}" wx:key="index">
        <image class="cert-image" src="{{item}}" mode="aspectFit"></image>
      </swiper-item>
    </swiper>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-text">正在加载...</text>
  </view>
</view>

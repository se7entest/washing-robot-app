/* company.wxss - 科技感设计 */
.container {
  background: #0a0e27;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 卡片通用样式 */
.section-card {
  margin: 0 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.12);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(10rpx);
}

/* 标题区域 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #00d4ff;
  letter-spacing: 2rpx;
  text-shadow: 0 0 16rpx rgba(0, 212, 255, 0.4);
}

.section-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(0, 212, 255, 0.3) 0%, transparent 100%);
  margin-left: 16rpx;
}

/* 内容文字 */
.section-content {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 2;
  display: block;
  text-align: justify;
}

/* 企业文化 */
.culture-content {
  background: rgba(0, 212, 255, 0.04);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.08);
}

.culture-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 2;
  display: block;
  white-space: pre-line;
}

/* 资质证书轮播 */
.cert-swiper {
  height: 300rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.cert-image {
  width: 100%;
  height: 300rpx;
  display: block;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.2;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.3);
}

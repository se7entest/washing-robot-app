/* device-detail.wxss */
.container {
  background: linear-gradient(180deg, #0a0e27 0%, #1a1f3a 100%);
  min-height: 100vh;
  position: relative;
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.detail-swiper {
  width: 100%;
  height: 500rpx;
}

.detail-image {
  width: 100%;
  height: 500rpx;
}

.info-card {
  margin: 20rpx;
}

.info-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.info-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.category-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.category-badge.badge-robot {
  background: #e8f0fe;
  color: #1a73e8;
}

.category-badge.badge-aircraft {
  background: #fef3e8;
  color: #e67e22;
}

.info-desc {
  margin-top: 20rpx;
}

.info-feature {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.spec-card, .scene-card {
  margin: 0 20rpx 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #1a73e8;
}

.spec-table {
  border-top: 1rpx solid #eee;
}

.spec-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.spec-name {
  font-size: 28rpx;
  color: #666;
}

.spec-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.scene-item {
  display: flex;
  align-items: flex-start;
}

.scene-image {
  width: 160rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #e0e0e0;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.scene-info {
  flex: 1;
}

.scene-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.scene-desc {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  display: block;
}

/* 视频演示入口 */
.video-cta {
  margin: 0 20rpx 20rpx;
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #1a73e8 0%, #4a9ff5 100%);
  border-radius: 12rpx;
}

.video-cta-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.video-cta-text {
  flex: 1;
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
}

.video-cta-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.8);
}

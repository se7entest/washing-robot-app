<!--device-detail.wxml-->
<view class="container" wx:if="{{device}}">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="onGoBack">
    <text class="back-icon">‹</text>
  </view>

  <!-- 图片轮播 -->
  <swiper class="detail-swiper" indicator-dots autoplay circular>
    <swiper-item wx:for="{{device.images || [device.image]}}" wx:key="index">
      <image src="{{item}}" mode="aspectFill" class="detail-image"></image>
    </swiper-item>
  </swiper>

  <!-- 设备基本信息 -->
  <view class="card info-card">
    <view class="info-title-wrap">
      <view class="info-title">{{device.name}}</view>
      <text class="category-badge {{device.category === '飞行器' ? 'badge-aircraft' : 'badge-robot'}}">{{device.category || '未知'}}</text>
    </view>
    <view class="info-desc" wx:if="{{device.features && device.features.length > 0}}">
      <text wx:for="{{device.features}}" wx:for-item="feat" wx:key="index" class="info-feature">• {{feat}}</text>
    </view>
  </view>

  <!-- 技术参数 -->
  <view class="card spec-card" wx:if="{{device.specs && device.specs.length > 0}}">
    <view class="card-title">技术参数</view>
    <view class="spec-table">
      <view class="spec-row" wx:for="{{device.specs}}" wx:key="name">
        <text class="spec-name">{{item.name}}</text>
        <text class="spec-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- 应用场景 -->
  <view class="card scene-card" wx:if="{{device.scenes && device.scenes.length > 0}}">
    <view class="card-title">应用场景</view>
    <view class="scene-list">
      <view class="scene-item" wx:for="{{device.scenes}}" wx:key="title">
        <image class="scene-image" src="{{item.image}}" mode="aspectFill" wx:if="{{item.image}}"></image>
        <view class="scene-info">
          <text class="scene-title">{{item.title}}</text>
          <text class="scene-desc">{{item.description}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 视频演示入口 -->
  <view class="video-cta card" bindtap="goToVideo">
    <text class="video-cta-icon">🎬</text>
    <text class="video-cta-text">观看视频演示</text>
    <text class="video-cta-arrow">›</text>
  </view>
</view>

<view class="empty" wx:else>
  <text>设备不存在</text>
</view>

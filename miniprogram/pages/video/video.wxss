/* video.wxss */
.video-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.video-placeholder-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.video-placeholder-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.video-placeholder-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

.video-list {
  padding: 20rpx;
}

.video-card {
  margin-bottom: 20rpx;
}

.video-thumb {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.video-image {
  width: 100%;
  height: 320rpx;
  background: #e0e0e0;
}

.video-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
}

.video-info {
  padding: 16rpx 0;
}

.video-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
}

.video-meta {
  margin-top: 8rpx;
}

.video-date {
  font-size: 24rpx;
  color: #999;
}

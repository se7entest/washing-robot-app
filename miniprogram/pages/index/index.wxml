<!--index.wxml-->
<view class="container">
  <!-- 轮播图 -->
  <swiper class="banner-swiper" indicator-dots="{{banners.length > 1}}" autoplay="{{banners.length > 1}}" circular interval="4000" wx:if="{{banners.length > 0}}">
    <swiper-item wx:for="{{banners}}" wx:key="_id">
      <image class="banner-image" src="{{item.image}}" mode="aspectFill" bindtap="onBannerTap" data-link="{{item.link}}"></image>
    </swiper-item>
  </swiper>

  <!-- 科技风头部 -->
  <view class="hero-section">
    <view class="hero-bg">
      <view class="hero-grid"></view>
      <view class="hero-scanline"></view>
    </view>
    <view class="hero-content">
      <text class="hero-title">智能清洗机器人</text>
      <text class="hero-subtitle">Drone & Robot Washing Technology</text>
      <text class="hero-desc">专业外墙清洗解决方案 | 高效 · 安全 · 智能</text>
    </view>
    <view class="hero-wave"></view>
  </view>

  <!-- 快捷服务 - 一横排六个个性化按钮 -->
  <view class="quick-section">
    <view class="quick-title">
      <view class="quick-title-line"></view>
      <text class="quick-title-text">快捷服务</text>
      <view class="quick-title-line"></view>
    </view>
    <view class="quick-grid">
      <block wx:for="{{quickLinks}}" wx:key="title">
        <!-- 公司简介 - 青色科技框 -->
        <view class="quick-item" wx:if="{{item.icon === 'company'}}" bindtap="onQuickLinkTap" data-page="{{item.page}}">
          <view class="qi qi-company">
            <view class="qi-corner tl"></view>
            <view class="qi-corner tr"></view>
            <view class="qi-corner bl"></view>
            <view class="qi-corner br"></view>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 21h18M3 7v14M21 7v14M6 7V3h12v4M9 21v-4h6v4"/>
            </svg>
          </view>
          <text class="quick-item-text">{{item.title}}</text>
        </view>
        <!-- 设备介绍 - 蓝色圆形雷达 -->
        <view class="quick-item" wx:if="{{item.icon === 'device'}}" bindtap="onQuickLinkTap" data-page="{{item.page}}">
          <view class="qi qi-device">
            <view class="qi-ring"></view>
            <view class="qi-dot"></view>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </view>
          <text class="quick-item-text">{{item.title}}</text>
        </view>
        <!-- 服务案例 - 绿色数据条 -->
        <view class="quick-item" wx:if="{{item.icon === 'case'}}" bindtap="onQuickLinkTap" data-page="{{item.page}}">
          <view class="qi qi-case">
            <view class="qi-bars">
              <view class="qi-bar"></view>
              <view class="qi-bar"></view>
              <view class="qi-bar"></view>
            </view>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </view>
          <text class="quick-item-text">{{item.title}}</text>
        </view>
        <!-- 合作意向 - 橙色六边形 -->
        <view class="quick-item" wx:if="{{item.icon === 'cooperate'}}" bindtap="onQuickLinkTap" data-page="{{item.page}}">
          <view class="qi qi-cooperate">
            <view class="qi-hex"></view>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/>
            </svg>
          </view>
          <text class="quick-item-text">{{item.title}}</text>
        </view>
        <!-- 预约演示 - 紫色脉冲圆 -->
        <view class="quick-item" wx:if="{{item.icon === 'appointment'}}" bindtap="onQuickLinkTap" data-page="{{item.page}}">
          <view class="qi qi-appointment">
            <view class="qi-pulse"></view>
            <view class="qi-pulse qi-pulse-2"></view>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </view>
          <text class="quick-item-text">{{item.title}}</text>
        </view>
        <!-- 视频演示 - 红色能量块 -->
        <view class="quick-item" wx:if="{{item.icon === 'video'}}" bindtap="onQuickLinkTap" data-page="{{item.page}}">
          <view class="qi qi-video">
            <view class="qi-triangle"></view>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </view>
          <text class="quick-item-text">{{item.title}}</text>
        </view>
        <!-- 默认样式（未知类型） -->
        <view class="quick-item" wx:if="{{item.icon !== 'company' && item.icon !== 'device' && item.icon !== 'case' && item.icon !== 'cooperate' && item.icon !== 'appointment' && item.icon !== 'video' && item.icon}}" bindtap="onQuickLinkTap" data-page="{{item.page}}">
          <view class="qi qi-default">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </view>
          <text class="quick-item-text">{{item.title}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 最新动态 -->
  <view class="section news-section">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-dot"></view>
        <text class="section-title">最新动态</text>
      </view>
    </view>
    <view class="news-list">
      <view class="news-item" wx:for="{{news}}" wx:key="_id" bindtap="goToNewsDetail" data-id="{{item._id}}">
        <view class="news-type-badge news-type-{{item.type}}">{{ getTypeLabel(item.type) }}</view>
        <view class="news-content">
          <text class="news-title">{{item.title}}</text>
        </view>
        <text class="news-time">{{item.date || ''}}</text>
      </view>
    </view>
  </view>

  <!-- 视频演示 -->
  <view class="section video-section" wx:if="{{videos.length > 0}}">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-dot"></view>
        <text class="section-title">视频演示</text>
      </view>
      <text class="section-more" bindtap="goToVideo">查看全部 ></text>
    </view>
    <view class="video-preview" wx:if="{{videos[0]}}" bindtap="goToVideo">
      <image class="video-preview-image" src="{{videos[0].thumbnail || '/assets/images/default-video.png'}}" mode="aspectFill"></image>
      <view class="video-preview-overlay">
        <view class="video-play-btn">
          <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </view>
      </view>
      <view class="video-preview-info">
        <text class="video-preview-title">{{videos[0].title}}</text>
        <text class="video-preview-desc">{{videos[0].description}}</text>
      </view>
    </view>
  </view>

  <!-- 精选案例 -->
  <view class="section card">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-dot"></view>
        <text class="section-title">精选案例</text>
      </view>
      <text class="section-more" bindtap="goToCases">查看更多 ></text>
    </view>
    <scroll-view class="case-scroll" scroll-x>
      <view class="case-list">
        <view class="case-item" wx:for="{{cases}}" wx:key="_id" bindtap="goToCaseDetail" data-id="{{item._id}}">
          <image class="case-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="case-info">
            <text class="case-title">{{item.title}}</text>
            <text class="case-location">{{item.location}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <text class="footer-text">© 2026 智能清洗机器人 · 科技创新驱动未来</text>
  </view>
</view>

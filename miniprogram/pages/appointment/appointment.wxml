<!--appointment.wxml-->
<view class="container">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="onGoBack">
    <text class="back-icon">‹</text>
  </view>

  <view class="form-card card">
    <view class="form-item">
      <text class="form-label">姓名 <text class="required">*</text></text>
      <input class="form-input" type="nickname" placeholder="请输入您的姓名" value="{{form.name}}" bindinput="onInputName" />
    </view>
    <view class="form-item">
      <text class="form-label">电话 <text class="required">*</text></text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入您的手机号" value="{{form.phone}}" bindinput="onInputPhone" />
    </view>
    <view class="form-item">
      <text class="form-label">公司名称</text>
      <input class="form-input" placeholder="请输入公司名称" value="{{form.company}}" bindinput="onInputCompany" />
    </view>
    <view class="form-item">
      <text class="form-label">预约日期 <text class="required">*</text></text>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="picker-display">
          {{form.date || '请选择预约日期'}}
        </view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">预约时间 <text class="required">*</text></text>
      <picker mode="selector" range="{{timeSlots}}" bindchange="onTimeChange">
        <view class="picker-display">
          {{form.time || '请选择预约时间'}}
        </view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">预约地点 <text class="required">*</text></text>
      <view class="location-display">
        <text class="location-text">{{form.location_name || '请点击选择地点'}}</text>
      </view>
      <button class="location-btn" bindtap="chooseLocation">📍 选择地点</button>
    </view>
    <view class="form-item">
      <text class="form-label">现场建筑物照片</text>
      <view class="photo-grid">
        <view class="photo-item" wx:for="{{form.photos}}" wx:key="index" bindtap="previewPhoto" data-index="{{index}}">
          <image src="{{item}}" mode="aspectFill" class="photo-preview"></image>
          <view class="photo-delete" bindtap="deletePhoto" data-index="{{index}}">×</view>
        </view>
        <view class="photo-item photo-add" bindtap="choosePhoto" wx:if="{{form.photos.length < 9}}">
          <text class="photo-add-icon">+</text>
        </view>
      </view>
    </view>
    <button class="btn-primary" bindtap="submitAppointment">提交预约</button>
  </view>
</view>

/* case-detail.wxss */
.case-detail-image {
  width: 100%;
  height: 400rpx;
  background: #e0e0e0;
}

.info-card {
  margin: 20rpx;
}

.case-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.case-meta {
  display: flex;
  margin-top: 16rpx;
  gap: 24rpx;
}

.meta-item {
  font-size: 26rpx;
  color: #666;
}

.section-card {
  margin: 0 20rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #1a73e8;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  display: block;
}

.review-card {
  margin: 0 20rpx 20rpx;
  background: #f8f9fa;
}

.review-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  display: block;
}

/* case.wxss */
.container {
  background: linear-gradient(180deg, #0a0e27 0%, #1a1f3a 100%);
  min-height: 100vh;
  position: relative;
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.filter-bar {
  margin: 20rpx;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
}

.filter-item {
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.filter-item.active {
  background: #1a73e8;
  color: #fff;
}

.case-grid {
  padding: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.case-card {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.case-image {
  width: 100%;
  height: 280rpx;
  background: #e0e0e0;
}

.case-content {
  padding: 16rpx;
}

.case-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.case-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.case-location {
  font-size: 22rpx;
  color: #999;
}

.case-date {
  font-size: 22rpx;
  color: #999;
}

<!-- news-detail.wxml -->
<view class="container">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="onGoBack">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="24" height="24">
      <path d="M15 19l-7-7 7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <text>返回</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{!news}}">
    <text>加载中...</text>
  </view>

  <!-- 内容 -->
  <view class="content" wx:if="{{news}}">
    <!-- 标题 -->
    <view class="news-header">
      <view class="news-type-badge news-type-{{news.type}}">{{getTypeLabel(news.type)}}</view>
      <text class="news-title">{{news.title}}</text>
      <text class="news-date">{{news.date || ''}}</text>
    </view>

    <!-- 封面图 -->
    <image class="news-cover" wx:if="{{news.cover}}" src="{{news.cover}}" mode="aspectFill"></image>

    <!-- 正文 -->
    <view class="news-body">
      <text>{{news.content}}</text>
    </view>
  </view>

  <!-- 加载失败 -->
  <view class="error" wx:if="{{error}}">
    <text>{{error}}</text>
  </view>
</view>

<!--video-play.wxml-->
<view class="container">
  <!-- 视频播放区域 -->
  <view class="video-wrapper">
    <video
      id="mainVideo"
      src="{{videoUrl}}"
      controls
      show-center-play-btn
      enable-progress-gesture
      object-fit="contain"
      bindtimeupdate="onTimeUpdate"
      bindended="onVideoEnd"
    ></video>
    <!-- 返回按钮 -->
    <view class="back-btn" bindtap="onGoBack">
      <text class="back-icon">‹</text>
      <text class="back-text">返回</text>
    </view>
  </view>

  <!-- 视频信息卡片 -->
  <view class="video-info-card">
    <view class="info-header">
      <view class="info-title-wrap">
        <text class="video-title">{{title}}</text>
        <view class="title-glow"></view>
      </view>
    </view>

    <view class="info-meta">
      <view class="meta-item">
        <text class="meta-label">发布日期</text>
        <text class="meta-value">{{publishDate}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">视频时长</text>
        <text class="meta-value">{{duration}}</text>
      </view>
    </view>

    <view class="info-desc">
      <text class="desc-label">视频简介</text>
      <text class="desc-content">{{description}}</text>
    </view>
  </view>
</view>

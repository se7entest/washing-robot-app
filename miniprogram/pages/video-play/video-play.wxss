/* video-play.wxss - 科技感设计 */
.container {
  background: linear-gradient(180deg, #0a0e27 0%, #1a1f3a 100%);
  min-height: 100vh;
}

/* 视频容器 */
.video-wrapper {
  position: relative;
  width: 100%;
  background: #000;
}

.video-wrapper video {
  width: 100%;
  height: 460rpx;
  display: block;
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
  margin-right: 4rpx;
}

.back-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 信息卡片 */
.video-info-card {
  margin: 24rpx 24rpx 0;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

/* 标题区域 */
.info-header {
  margin-bottom: 24rpx;
}

.info-title-wrap {
  position: relative;
}

.video-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #00d4ff;
  display: block;
  line-height: 1.4;
  text-shadow: 0 0 20rpx rgba(0, 212, 255, 0.4);
}

.title-glow {
  position: absolute;
  bottom: -8rpx;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: linear-gradient(90deg, #00d4ff 0%, transparent 100%);
  border-radius: 2rpx;
  opacity: 0.6;
}

/* 元数据 */
.info-meta {
  display: flex;
  gap: 40rpx;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.meta-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 1rpx;
}

.meta-value {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 简介区域 */
.info-desc {
  background: rgba(0, 212, 255, 0.05);
  border-radius: 16rpx;
  padding: 24rpx;
}

.desc-label {
  font-size: 24rpx;
  color: rgba(0, 212, 255, 0.7);
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.desc-content {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.8;
  display: block;
}

/* 视频结束处理 */
.on-video-end {
  opacity: 0.8;
}

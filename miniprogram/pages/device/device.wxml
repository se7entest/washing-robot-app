<!--device.wxml-->
<view class="container">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="onGoBack">
    <text class="back-icon">‹</text>
  </view>

  <!-- 分类筛选 -->
  <view class="filter-bar card">
    <scroll-view class="filter-scroll" scroll-x>
      <view class="filter-list">
        <view
          class="filter-item {{currentFilter === item.id ? 'active' : ''}}"
          wx:for="{{filters}}"
          wx:key="id"
          bindtap="onFilterTap"
          data-id="{{item.id}}"
        >
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 设备列表 -->
  <view class="device-list" wx:if="{{!loading && devices.length > 0}}">
    <view
      class="device-card card"
      wx:for="{{devices}}"
      wx:key="_id"
      bindtap="goToDetail"
      data-id="{{item._id}}"
    >
      <image class="device-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="device-info">
        <view class="device-name-wrap">
          <text class="device-name">{{item.name}}</text>
          <text class="category-badge {{item.category === '飞行器' ? 'badge-aircraft' : 'badge-robot'}}">{{item.category || '未知'}}</text>
        </view>
        <text class="device-desc">{{item.features[0]}}</text>
        <view class="device-tags">
          <text class="device-tag" wx:for="{{item.features}}" wx:for-item="tag" wx:key="index" wx:if="{{index < 2}}">{{tag}}</text>
        </view>
      </view>
      <view class="device-arrow">></view>
    </view>
  </view>

  <!-- loading -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && devices.length === 0}}">
    <text>暂无设备信息</text>
  </view>
</view>

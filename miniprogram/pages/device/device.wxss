/* device.wxss */
.container {
  background: linear-gradient(180deg, #0a0e27 0%, #1a1f3a 100%);
  min-height: 100vh;
  position: relative;
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.filter-bar {
  margin: 20rpx;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
}

.filter-item {
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.filter-item.active {
  background: #1a73e8;
  color: #fff;
}

.device-list {
  padding: 0 20rpx;
}

.device-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.device-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #e0e0e0;
  flex-shrink: 0;
}

.device-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.device-name-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.category-badge.badge-robot {
  background: #e8f0fe;
  color: #1a73e8;
}

.category-badge.badge-aircraft {
  background: #fef3e8;
  color: #e67e22;
}

.device-desc {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.device-tag {
  font-size: 22rpx;
  color: #1a73e8;
  background: #e8f0fe;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.device-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 16rpx;
}

/* loading */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-dots {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.loading-dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #1a73e8;
  animation: dotBounce 1.2s ease-in-out infinite;
}

.loading-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* empty */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
